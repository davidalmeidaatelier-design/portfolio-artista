---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanity } from '@/lib/sanity';

const exposicoes = await sanity.fetch(`
  *[
    _type == "projeto" &&
    categoria == "exposicao" &&
    publicado == true &&
    status == "atual"
  ] | order(dataInicio desc) {
    _id,
    titulo,
    slug,
    local,
    dataInicio,
    dataFim,
    "capa": imagensMontagem[0].asset->url
  }
`);
---

<BaseLayout title="Home" locale="en">
  <div class="container">

    {(exposicoes ?? []).length > 0 && (
      <section class="destaque" aria-label="Current exhibitions">
        <span class="ficha-tecnica destaque__eyebrow">
          Current exhibitions
        </span>

        <div class="carousel" data-carousel>
          <div class="carousel__viewport">
            <div class="carousel__track" data-carousel-track>

              {(exposicoes ?? []).map((exposicao: any) => (
                <article class="carousel__slide">

                  <a
                    href={`/en/exhibitions/${exposicao.slug?.current}`}
                    class="carousel__imagem-link"
                  >
                    {exposicao.capa && (
                      <img
                        src={exposicao.capa}
                        alt={exposicao.titulo?.en || exposicao.titulo?.pt || ''}
                        class="destaque__imagem"
                        loading="eager"
                      />
                    )}
                  </a>

                  <div class="destaque__info">
                    <h1 class="destaque__titulo">
                      {exposicao.titulo?.en || exposicao.titulo?.pt}
                    </h1>

                    {(exposicao.local?.en || exposicao.local?.pt) && (
                      <div class="ficha-tecnica destaque__meta">
                        {exposicao.local?.en || exposicao.local?.pt}
                      </div>
                    )}

                    <a
                      href={`/en/exhibitions/${exposicao.slug?.current}`}
                      class="destaque__link"
                    >
                      View full exhibition →
                    </a>
                  </div>

                </article>
              ))}

            </div>
          </div>

          {(exposicoes ?? []).length > 1 && (
            <div class="carousel__controls">
              <button
                type="button"
                class="carousel__button"
                data-carousel-prev
                aria-label="Previous exhibition"
              >
                ←
              </button>

              <span
                class="carousel__counter"
                data-carousel-counter
                aria-live="polite"
              >
                1 / {(exposicoes ?? []).length}
              </span>

              <button
                type="button"
                class="carousel__button"
                data-carousel-next
                aria-label="Next exhibition"
              >
                →
              </button>
            </div>
          )}

        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .destaque {
    padding-block: var(--space-4);
  }

  .destaque__eyebrow {
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-2);
  }

  .carousel {
    position: relative;
  }

  .carousel__viewport {
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    transition: transform 450ms ease;
    will-change: transform;
  }

  .carousel__slide {
    min-width: 100%;
    display: grid;
    grid-template-columns: 1.5fr 0.5fr;
    gap: var(--space-4);
    align-items: center;
  }

  .carousel__imagem-link {
    display: block;
  }

  .destaque__imagem {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .destaque__titulo {
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1.12;
    margin: 0 0 var(--space-2);
  }

  .destaque__meta {
    color: var(--color-muted);
    margin-bottom: var(--space-2);
    line-height: 1.4;
  }

  .destaque__link {
    display: inline-block;
    margin-top: var(--space-1);
    font-size: 0.8rem;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .carousel__button {
    appearance: none;
    border: 0;
    background: transparent;
    padding: 0.15rem;
    font: inherit;
    cursor: pointer;
    line-height: 1;
  }

  .carousel__counter {
    font-size: 0.7rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .carousel__slide {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .destaque__titulo {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      transition: none;
    }
  }
</style>

<script>
  const carousel = document.querySelector('[data-carousel]');

  if (carousel) {
    const track = carousel.querySelector('[data-carousel-track]');
    const slides = carousel.querySelectorAll('.carousel__slide');
    const previous = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    const counter = carousel.querySelector('[data-carousel-counter]');

    let current = 0;

    const update = () => {
      if (!track) return;

      track.style.transform = `translateX(-${current * 100}%)`;

      if (counter) {
        counter.textContent = `${current + 1} / ${slides.length}`;
      }
    };

    previous?.addEventListener('click', () => {
      current = current === 0 ? slides.length - 1 : current - 1;
      update();
    });

    next?.addEventListener('click', () => {
      current = current === slides.length - 1 ? 0 : current + 1;
      update();
    });
  }
</script>
