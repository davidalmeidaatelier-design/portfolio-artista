---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { sanity, QUERY_EXPOSICAO_POR_SLUG } from '../../../lib/sanity';

export async function getStaticPaths() {
  const exposicoes = await sanity.fetch(`
    *[_type == "projeto" && categoria == "exposicao" && publicado == true] {
      "slug": slug.current
    }
  `);

  return (exposicoes ?? [])
    .filter((exposicao: any) => exposicao?.slug)
    .map((exposicao: any) => ({
      params: { slug: exposicao.slug }
    }));
}

const { slug } = Astro.params;

const exposicao = await sanity.fetch(
  QUERY_EXPOSICAO_POR_SLUG,
  { slug }
);

if (!exposicao) {
  return Astro.redirect('/en/exhibitions');
}

const titulo = exposicao.titulo?.en || exposicao.titulo?.pt;
const local = exposicao.local?.en || exposicao.local?.pt;
---

<BaseLayout
  title={titulo}
  locale="en"
>
  <article class="container exposicao-page">

    <header class="exposicao-page__header">

      <h1>{titulo}</h1>

      {exposicao.textosRelacionados?.length > 0 && (
        <a
          href={`/en/texts/${exposicao.textosRelacionados[0].slug.current}`}
          class="exposicao-page__texto-link"
        >
          Read the exhibition text →
        </a>
      )}

      <div class="ficha-tecnica exposicao-page__meta">

        {local && (
          <span>{local}</span>
        )}

        {exposicao.dataInicio && (
          <span>
            {new Date(exposicao.dataInicio).toLocaleDateString('en-GB')}
          </span>
        )}

        {exposicao.dataFim && (
          <span>
            – {new Date(exposicao.dataFim).toLocaleDateString('en-GB')}
          </span>
        )}

      </div>

    </header>


    {exposicao.imagensMontagem?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">
          Exhibition views
        </h2>

        <div class="exposicao-page__galeria">
          {exposicao.imagensMontagem.map((img: any) => (
            <div class="galeria-imagem">
              <img
                src={img.url}
                alt=""
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )}


    {exposicao.imagensObras?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">
          Works
        </h2>

        <div class="exposicao-page__galeria">
          {exposicao.imagensObras.map((img: any) => (
            <div class="galeria-imagem">
              <img
                src={img.url}
                alt=""
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )}


    {exposicao.imagensDetalhe?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">
          Details
        </h2>

        <div class="exposicao-page__galeria">
          {exposicao.imagensDetalhe.map((img: any) => (
            <div class="galeria-imagem">
              <img
                src={img.url}
                alt=""
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )}


    {exposicao.texto?.en && (
      <section id="exhibition-text" class="exposicao-page__texto">
        <h2 class="exposicao-page__secao">Exhibition text</h2>

        <div class="exposicao-page__texto-conteudo">
          {Array.isArray(exposicao.texto.en) && exposicao.texto.en.map((block: any) => (
            block?._type === 'block' && (
              <p>
                {block.children?.map((child: any) => child.text || '').join('')}
              </p>
            )
          ))}
        </div>
      </section>
    )}


    {(exposicao.obrasRelacionadas ?? []).length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">
          Related works
        </h2>

        <div class="exposicao-page__obras">
          {(exposicao.obrasRelacionadas ?? []).map((obra: any) => (
            <a
              href={`/en/works/${obra.serie?.slug?.current}/${obra.slug.current}`}
              class="exposicao-page__obra"
            >
              {obra.imagem && (
                <img
                  src={obra.imagem}
                  alt={obra.titulo?.en || obra.titulo?.pt}
                  loading="lazy"
                />
              )}

              <span>
                {obra.titulo?.en || obra.titulo?.pt}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}


    {(exposicao.imagensOutras ?? []).length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">
          Other images
        </h2>

        <div class="exposicao-page__galeria">
          {(exposicao.imagensOutras ?? []).map((img: any) => (
            <div class="galeria-imagem">
              <img
                src={img.url}
                alt=""
                loading="lazy"
              />
            </div>
          ))}
        </div>
      </section>
    )}


    {(exposicao.textosRelacionados ?? []).length > 0 && (
      <section class="exposicao-page__textos">
        <h2 class="exposicao-page__secao">
          Related texts
        </h2>

        <ul>
          {(exposicao.textosRelacionados ?? []).map((t: any) => (
            <li>
              <a href={`/en/texts/${t.slug.current}`}>
                {t.titulo?.en || t.titulo?.pt}
              </a>

              {t.autor && ` — ${t.autor}`}
            </li>
          ))}
        </ul>
      </section>
    )}


    {(exposicao.creditoFotosObras ||
      exposicao.creditoFotosVistas ||
      exposicao.creditoFotosDetalhes ||
      exposicao.creditoFotosOutras) && (
      <section class="exposicao-page__creditos">
        <h2 class="exposicao-page__creditos-titulo">
          Photography credits
        </h2>

        <div class="exposicao-page__creditos-lista">
          {exposicao.creditoFotosObras && (
            <p>
              <strong>Work photographs:</strong>{' '}
              {exposicao.creditoFotosObras}
            </p>
          )}

          {exposicao.creditoFotosVistas && (
            <p>
              <strong>Installation views:</strong>{' '}
              {exposicao.creditoFotosVistas}
            </p>
          )}

          {exposicao.creditoFotosDetalhes && (
            <p>
              <strong>Detail photographs:</strong>{' '}
              {exposicao.creditoFotosDetalhes}
            </p>
          )}

          {exposicao.creditoFotosOutras && (
            <p>
              <strong>Other photographs:</strong>{' '}
              {exposicao.creditoFotosOutras}
            </p>
          )}
        </div>
      </section>
    )}

  </article>
</BaseLayout>

<style>
  .exposicao-page {
    padding-block: var(--space-4);
  }

  .exposicao-page__header {
    margin-bottom: 4rem;
  }

  .exposicao-page__header h1 {
    margin-bottom: 1rem;
  }

  .exposicao-page__texto-link {
    display: inline-block;
    margin-bottom: 1.5rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .exposicao-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--color-muted);
  }

  .exposicao-page__secao {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-top: 5rem;
    margin-bottom: 2rem;
  }

  .exposicao-page__galeria {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8rem;
  }

  .galeria-imagem {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .galeria-imagem img {
    width: auto;
    max-width: 78%;
    height: auto;
    max-height: 82vh;
    display: block;
    object-fit: contain;
  }

  .exposicao-page__obras {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 3rem;
  }

  .exposicao-page__obra {
    display: block;
  }

  .exposicao-page__obra img {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 1rem;
  }

  .exposicao-page__textos {
    margin-top: 7rem;
    padding-bottom: 5rem;
  }

  .exposicao-page__creditos {
    margin-top: 8rem;
    padding-top: 2rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--color-muted);
    max-width: 44rem;
  }

  .exposicao-page__creditos-titulo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }

  .exposicao-page__creditos-lista p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .exposicao-page__texto {
    margin-top: 8rem;
    max-width: 44rem;
    padding-bottom: 5rem;
  }

  .exposicao-page__texto-conteudo {
    font-size: 1rem;
    line-height: 1.6;
  }

  .exposicao-page__texto-conteudo p {
    margin: 0 0 1.5rem;
  }

  .exposicao-page__texto-conteudo p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .exposicao-page__galeria {
      gap: 5rem;
    }

    .galeria-imagem img {
      max-width: 100%;
      max-height: none;
    }
  }
</style>