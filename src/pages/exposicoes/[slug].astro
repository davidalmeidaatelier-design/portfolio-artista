---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { sanity, QUERY_EXPOSICAO_POR_SLUG } from '@/lib/sanity';

export async function getStaticPaths() {
  const exposicoes = await sanity.fetch(`
    *[_type == "projeto" && categoria == "exposicao" && publicado == true] {
      "slug": slug.current
    }
  `);

  return exposicoes
    .filter((exposicao: any) => exposicao.slug)
    .map((exposicao: any) => ({
      params: { slug: exposicao.slug }
    }));
}

const { slug } = Astro.params;
const exposicao = await sanity.fetch(QUERY_EXPOSICAO_POR_SLUG, { slug });

if (!exposicao) return Astro.redirect('/exposicoes');
---

<BaseLayout title={exposicao.titulo?.pt} locale="pt">
  <article class="container exposicao-page">

    <header class="exposicao-page__header">
      <h1>{exposicao.titulo?.pt}</h1>

      {exposicao.texto?.pt && (
        <a
          href="#texto-exposicao"
          class="exposicao-page__texto-link"
        >
          Ler o texto da exposição ↓
        </a>
      )}
    </header>

    <div class="ficha-tecnica exposicao-page__meta">
      {exposicao.local?.pt && <span>{exposicao.local.pt}</span>}

      {exposicao.dataInicio && (
        <span>
          {new Date(exposicao.dataInicio).toLocaleDateString('pt-BR')}
        </span>
      )}

      {exposicao.dataFim && (
        <span>
          – {new Date(exposicao.dataFim).toLocaleDateString('pt-BR')}
        </span>
      )}
    </div>


    {exposicao.imagensMontagem?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">Vistas da exposição</h2>

        <div class="exposicao-page__galeria-blocos">
          {exposicao.imagensMontagem.map((img: any, i: number) => (
            i % 3 === 0 ? (
              <div class="galeria-bloco galeria-bloco--uma">
                <img src={img.url} alt="" loading="lazy" />
              </div>
            ) : i % 3 === 1 ? (
              <div class="galeria-bloco galeria-bloco--duas">
                <img src={img.url} alt="" loading="lazy" />

                {exposicao.imagensMontagem[i + 1] && (
                  <img
                    src={exposicao.imagensMontagem[i + 1].url}
                    alt=""
                    loading="lazy"
                  />
                )}
              </div>
            ) : null
          ))}
        </div>
      </section>
    )}


    {exposicao.imagensObras?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">Obras</h2>

        <div class="exposicao-page__galeria-blocos">
          {exposicao.imagensObras.map((img: any, i: number) => (
            i % 3 === 0 ? (
              <div class="galeria-bloco galeria-bloco--uma">
                <img src={img.url} alt="" loading="lazy" />
              </div>
            ) : i % 3 === 1 ? (
              <div class="galeria-bloco galeria-bloco--duas">
                <img src={img.url} alt="" loading="lazy" />

                {exposicao.imagensObras[i + 1] && (
                  <img
                    src={exposicao.imagensObras[i + 1].url}
                    alt=""
                    loading="lazy"
                  />
                )}
              </div>
            ) : null
          ))}
        </div>
      </section>
    )}


    {exposicao.imagensDetalhe?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">Detalhes</h2>

        <div class="exposicao-page__galeria-blocos">
          {exposicao.imagensDetalhe.map((img: any, i: number) => (
            i % 3 === 0 ? (
              <div class="galeria-bloco galeria-bloco--uma">
                <img src={img.url} alt="" loading="lazy" />
              </div>
            ) : i % 3 === 1 ? (
              <div class="galeria-bloco galeria-bloco--duas">
                <img src={img.url} alt="" loading="lazy" />

                {exposicao.imagensDetalhe[i + 1] && (
                  <img
                    src={exposicao.imagensDetalhe[i + 1].url}
                    alt=""
                    loading="lazy"
                  />
                )}
              </div>
            ) : null
          ))}
        </div>
      </section>
    )}


    {exposicao.texto?.pt && (
      <section id="texto-exposicao" class="exposicao-page__texto">
        <h2 class="exposicao-page__secao">Texto de apresentação</h2>

        <div class="exposicao-page__texto-conteudo">
          {exposicao.texto.pt.map((block: any) => (
            block?._type === 'block' && (
              <p>
                {block.children?.map((child: any) => child.text || '').join('')}
              </p>
            )
          ))}
        </div>
      </section>
    )}


    {exposicao.obrasRelacionadas?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">Obras relacionadas</h2>

        <div class="exposicao-page__obras">
          {exposicao.obrasRelacionadas.map((obra: any) => (
            <a
              href={`/obras/${obra.serie?.slug?.current}/${obra.slug.current}`}
              class="exposicao-page__obra"
            >
              {obra.imagem && (
                <img
                  src={obra.imagem}
                  alt={obra.titulo?.pt}
                  loading="lazy"
                />
              )}

              <span>{obra.titulo?.pt}</span>
            </a>
          ))}
        </div>
      </section>
    )}


    {exposicao.imagensOutras?.length > 0 && (
      <section>
        <h2 class="exposicao-page__secao">Outras imagens</h2>

        <div class="exposicao-page__galeria-blocos">
          {exposicao.imagensOutras.map((img: any, i: number) => (
            i % 3 === 0 ? (
              <div class="galeria-bloco galeria-bloco--uma">
                <img src={img.url} alt="" loading="lazy" />
              </div>
            ) : i % 3 === 1 ? (
              <div class="galeria-bloco galeria-bloco--duas">
                <img src={img.url} alt="" loading="lazy" />

                {exposicao.imagensOutras[i + 1] && (
                  <img
                    src={exposicao.imagensOutras[i + 1].url}
                    alt=""
                    loading="lazy"
                  />
                )}
              </div>
            ) : null
          ))}
        </div>
      </section>
    )}


    {(exposicao.creditoFotosObras ||
      exposicao.creditoFotosVistas ||
      exposicao.creditoFotosDetalhes ||
      exposicao.creditoFotosOutras) && (
      <section class="exposicao-page__creditos">
        <h2 class="exposicao-page__creditos-titulo">
          Créditos das fotografias
        </h2>

        <div class="exposicao-page__creditos-lista">
          {exposicao.creditoFotosObras && (
            <p>
              <strong>Foto das obras:</strong>{' '}
              {exposicao.creditoFotosObras}
            </p>
          )}

          {exposicao.creditoFotosVistas && (
            <p>
              <strong>Foto das vistas:</strong>{' '}
              {exposicao.creditoFotosVistas}
            </p>
          )}

          {exposicao.creditoFotosDetalhes && (
            <p>
              <strong>Foto dos detalhes:</strong>{' '}
              {exposicao.creditoFotosDetalhes}
            </p>
          )}

          {exposicao.creditoFotosOutras && (
            <p>
              <strong>Outras fotografias:</strong>{' '}
              {exposicao.creditoFotosOutras}
            </p>
          )}
        </div>
      </section>
    )}

  </article>
</BaseLayout>

<style>
  .exposicao-page {
    padding-block: var(--space-4);
  }

  .exposicao-page__header {
    margin-bottom: 4rem;
  }

  .exposicao-page__header h1 {
    margin-bottom: 1rem;
  }

  .exposicao-page__texto-link {
    display: inline-block;
    margin-top: 1.5rem;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    font-size: 0.85rem;
  }

  .exposicao-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--color-muted);
  }

  .exposicao-page__secao {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin-top: 5rem;
    margin-bottom: 2rem;
  }

  .exposicao-page__galeria-blocos {
    display: flex;
    flex-direction: column;
  }

  .galeria-bloco {
    width: 100%;
    margin-bottom: 7rem;
  }

  .galeria-bloco--uma {
    display: flex;
    justify-content: center;
  }

  .galeria-bloco--uma img {
    width: auto;
    max-width: 78%;
    height: auto;
    max-height: 82vh;
    display: block;
  }

  .galeria-bloco--duas {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 5rem;
  }

  .galeria-bloco--duas img {
    width: auto;
    max-width: calc(50% - 2.5rem);
    height: auto;
    max-height: 75vh;
    display: block;
    object-fit: contain;
  }

  .galeria-bloco:last-child {
    margin-bottom: 0;
  }

  .exposicao-page__obras {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 3rem;
  }

  .exposicao-page__obra {
    display: block;
  }

  .exposicao-page__obra img {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 1rem;
  }

  .exposicao-page__creditos {
    margin-top: 8rem;
    padding-top: 2rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--color-muted);
    max-width: 44rem;
  }

  .exposicao-page__creditos-titulo {
    font-family: var(--font-display);
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
  }

  .exposicao-page__creditos-lista p {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .exposicao-page__texto {
    margin-top: 8rem;
    max-width: 44rem;
    padding-bottom: 5rem;
  }

  .exposicao-page__texto-conteudo {
    font-size: 1rem;
    line-height: 1.6;
  }

  .exposicao-page__texto-conteudo p {
    margin: 0 0 1.5rem;
  }

  .exposicao-page__texto-conteudo p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 700px) {
    .galeria-bloco {
      margin-bottom: 4rem;
    }

    .galeria-bloco--uma img {
      max-width: 100%;
      max-height: none;
    }

    .galeria-bloco--duas {
      flex-direction: column;
      align-items: center;
      gap: 4rem;
    }

    .galeria-bloco--duas img {
      max-width: 100%;
      max-height: none;
    }
  }
</style>