---
interface Props { locale: 'pt' | 'en' }
const { locale } = Astro.props;

const nav = {
  pt: [
    { href: '/obras', label: 'Obras' },
    { href: '/projetos', label: 'Projetos' },
    { href: '/exposicoes', label: 'Exposições' },
    { href: '/agenda', label: 'Agenda' },
    { href: '/textos', label: 'Textos' },
    { href: '/sobre', label: 'Sobre' },
    { href: '/contato', label: 'Contato' },
  ],
  en: [
    { href: '/en/works', label: 'Works' },
    { href: '/en/projects', label: 'Projects' },
    { href: '/en/exhibitions', label: 'Exhibitions' },
    { href: '/en/agenda', label: 'Agenda' },
    { href: '/en/texts', label: 'Texts' },
    { href: '/en/about', label: 'About' },
    { href: '/en/contact', label: 'Contact' },
  ],
};

const otherLocaleHref = locale === 'pt' ? '/en' : '/';
const otherLocaleLabel = locale === 'pt' ? 'EN' : 'PT';
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href={locale === 'pt' ? '/' : '/en'} class="site-header__mark">David Almeida</a>
    <nav class="site-header__nav" aria-label="Navegação principal">
      {nav[locale].map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={otherLocaleHref} class="site-header__locale">{otherLocaleLabel}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
  }
  .site-header__mark {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .site-header__nav {
    display: flex;
    gap: var(--space-3);
    font-size: 0.9rem;
  }
  .site-header__locale {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  @media (max-width: 640px) {
    .site-header__inner { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
    .site-header__nav { flex-wrap: wrap; gap: var(--space-2); }
  }
</style>
